<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Hospital Dashboard</title>

  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f7fa;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .table {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }

        .header {
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container py-4">

        
        <div class="mb-4">
            <h2 class="fw-bold">🏥 Hospital Dashboard</h2>
            <p class="text-muted">Overview of system data</p>
        </div>

     
        <div class="row g-4 mb-4">

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Doctors</h6>
                    <h3>
                        <%= doctors.length %>
                    </h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Patients</h6>
                    <h3>
                        <%= patients.length %>
                    </h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Appointments</h6>
                    <h3>
                        <%= appointments.length %>
                    </h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6 class="text-muted">Departments</h6>
                    <h3>
                        <%= departments.length %>
                    </h3>
                </div>
            </div>

        </div>

        <div class="mb-5">
            <h5 class="header mb-3">Doctors</h5>

            <table class="table table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Specialization</th>
                        <th>Department</th>
                    </tr>
                </thead>
                <tbody>
                    <% doctors.forEach(doc=> { %>
                        <tr>
                            <td>
                                <%= doc.name %>
                            </td>
                            <td>
                                <%= doc.specialization %>
                            </td>
                            <td>
                                <%= doc.department?.name %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>

       
        <div class="mb-5">
            <h5 class="header mb-3">Patients</h5>

            <table class="table table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Blood Group</th>
                    </tr>
                </thead>
                <tbody>
                    <% patients.forEach(p=> { %>
                        <tr>
                            <td>
                                <%= p.name %>
                            </td>
                            <td>
                                <%= p.mobileNumber %>
                            </td>
                            <td>
                                <%= p.bloodGroup %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>

        
        
<a href="/api/status" target="_blank" class="btn btn-dark">
    <i class="bi bi-server"></i> Check API Status
</a>
    </div>

</body>

</html>